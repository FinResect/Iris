# 由 build-iris / sync-iris 共享：解析 EFINITY_HOME 并 source setup.sh
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONF_FILE="$SCRIPT_DIR/../path/efinity_home"   # 仓库根目录/path/efinity_home

if [[ -z "${EFINITY_HOME:-}" ]]; then
    if [[ -s "$CONF_FILE" ]]; then
        EFINITY_HOME="$(<"$CONF_FILE")"
    else
        read -rp "未设置 EFINITY_HOME，请输入 Efinity 安装根目录(如 /home/fr/efinity/2026.1): " EFINITY_HOME
        mkdir -p "$(dirname "$CONF_FILE")"
        printf '%s\n' "$EFINITY_HOME" > "$CONF_FILE"
        echo "已保存到 $CONF_FILE"
    fi
fi

SETUP_SH="$EFINITY_HOME/bin/setup.sh"
if [[ ! -f "$SETUP_SH" ]]; then
    echo "错误：找不到 $SETUP_SH" >&2
    rm -f "$CONF_FILE"
    exit 1
fi
# 官方 setup.sh 未按 strict-mode 编写（含 `ldd|head` 等良性管道，
# 上游可能收到 SIGPIPE），故临时关闭 errexit/nounset/pipefail 再 source。
# 注意：不能用 `_s=$(set +o)` 保存——bash 在 $( ) 子 shell 里不继承 -e，
# 会把 errexit 误存为关闭状态。必须显式记录。
_saved_e=0; _saved_u=0; _saved_pf=0
if [[ $- == *e* ]]; then _saved_e=1; fi
if [[ $- == *u* ]]; then _saved_u=1; fi
if [[ -o pipefail ]]; then _saved_pf=1; fi

set +e +u
set +o pipefail
source "$SETUP_SH"

(( _saved_u ))  && set -u          || true
(( _saved_pf )) && set -o pipefail || true
(( _saved_e ))  && set -e          || true
