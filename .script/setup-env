#!/usr/bin/env bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# 1) 解析 EFINITY_HOME（环境变量 → Iris/path/efinity_home → 提示并保存）
source "$SCRIPT_DIR/efinity-env"

# 2) 确认工具可用
if ! command -v efx_run >/dev/null 2>&1; then
    echo "❌ 未找到 efx_run，EFINITY_HOME 可能不正确：$EFINITY_HOME" >&2
    exit 1
fi

# 3) 安装 USB udev 规则（需 sudo）
"$SCRIPT_DIR/setup-usb"

# 4) 版本校验与汇总
proj_ver="$(grep -o 'sw_version="[^"]*"' "$SCRIPT_DIR/../iris_ws/iris_ws.xml" 2>/dev/null | head -1 | cut -d'"' -f2)"
tool_ver="$(tr -d '[:space:]' < "$EFINITY_HOME/scripts/sw_version.txt" 2>/dev/null)"
echo "==> EFINITY_HOME : $EFINITY_HOME"
echo "==> 工具版本     : ${tool_ver:-未知}"
echo "==> 工程版本     : ${proj_ver:-未知}"
if [[ -n "$proj_ver" && -n "$tool_ver" && "$proj_ver" != "$tool_ver" ]]; then
    echo "⚠️  版本不一致：工程 $proj_ver / 工具 $tool_ver，建议使用与工程相同的 Efinity 版本。"
fi
echo "==> 环境配置完成"
